<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>TriggerButtonIndex</key>
    <integer>5</integer>
    <key>ThresholdDistance</key>
    <real>35.0</real>
    <key>DeadzoneRadius</key>
    <real>8.0</real>
    <key>GestureWindowMs</key>
    <real>200.0</real>
    <key>ShowMenuBarIcon</key>
    <true/>
    <key>SwallowTriggerEvents</key>
    <true/>
    <key>EnableSideButtons</key>
    <true/>
    <key>BackButtonIndex</key>
    <integer>3</integer>
    <key>ForwardButtonIndex</key>
    <integer>4</integer>
    <key>ClickAction</key>
    <dict>
        <key>Type</key><string>Shortcut</string>
        <key>KeyCode</key><integer>126</integer>
        <key>Modifiers</key><array><string>Control</string></array>
        <key>Comment</key><string>Mission Control (Ctrl+Up)</string>
    </dict>
    <key>DragLeftAction</key>
    <dict>
        <key>Type</key><string>Shortcut</string>
        <key>KeyCode</key><integer>124</integer>
        <key>Modifiers</key><array><string>Control</string></array>
        <key>Comment</key><string>Natural swipe left -&gt; switch to Right Space</string>
    </dict>
    <key>DragRightAction</key>
    <dict>
        <key>Type</key><string>Shortcut</string>
        <key>KeyCode</key><integer>123</integer>
        <key>Modifiers</key><array><string>Control</string></array>
        <key>Comment</key><string>Natural swipe right -&gt; switch to Left Space</string>
    </dict>
    <key>DragUpAction</key>
    <dict>
        <key>Type</key><string>Shortcut</string>
        <key>KeyCode</key><integer>126</integer>
        <key>Modifiers</key><array><string>Control</string></array>
        <key>Comment</key><string>Mission Control</string>
    </dict>
    <key>DragDownAction</key>
    <dict>
        <key>Type</key><string>Shortcut</string>
        <key>KeyCode</key><integer>125</integer>
        <key>Modifiers</key><array><string>Control</string></array>
        <key>Comment</key><string>App Expose (Ctrl+Down)</string>
    </dict>

    <!-- Per-Application Contextual Profiles (override any gestures per app) -->
    <key>Applications</key>
    <dict>
        <!-- Visual Studio Code: Back/Forward navigates editor history (^ - and ^ ⇧ - via Equal keycode 24) -->
        <key>com.microsoft.VSCode</key>
        <dict>
            <key>BackButtonAction</key>
            <dict>
                <key>Type</key><string>Shortcut</string>
                <key>KeyCode</key><integer>24</integer>
                <key>Modifiers</key><array><string>Control</string></array>
                <key>Comment</key><string>VS Code Navigate Back (Ctrl+- / code: Equal)</string>
            </dict>
            <key>ForwardButtonAction</key>
            <dict>
                <key>Type</key><string>Shortcut</string>
                <key>KeyCode</key><integer>24</integer>
                <key>Modifiers</key><array><string>Control</string><string>Shift</string></array>
                <key>Comment</key><string>VS Code Navigate Forward (Ctrl+Shift+- / code: Equal)</string>
            </dict>
        </dict>
    </dict>
</dict>
</plist>

